{
  "name": "fluid-crowd-defense",
  "version": "0.1.0-alpha",
  "description": "Strategy PWA game with fluid crowd simulation and element combination system",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "analyze": "webpack-bundle-analyzer dist/stats.json"
  },
  "keywords": [
    "game",
    "pwa",
    "phaser",
    "strategy",
    "fluid-simulation",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.55.2",
    "localforage": "^1.10.0",
    "uuid": "^9.0.0",
    "miniplex": "^2.0.0",
    "bitecs": "^0.3.0",
    "simplex-noise": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.19.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "puppeteer": "^21.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "prettier": "^3.0.0",
    "webpack-bundle-analyzer": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Safari versions",
    "last 2 Firefox versions",
    "last 2 Edge versions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/fluid-crowd-defense.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/fluid-crowd-defense/issues"
  },
  "homepage": "https://github.com/yourusername/fluid-crowd-defense#readme"
}